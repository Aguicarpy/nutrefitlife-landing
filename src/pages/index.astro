---
import Layout from '../layouts/Layout.astro';
import { Header } from '../components/Header';
import { Hero } from '../components/Hero';
import { About } from '../components/About';
import { Products } from '../components/Products';
import { Consultoria } from '../components/Consultoria';
import { DeliveryInfo } from '../components/DeliveryInfo';
import { Footer } from '../components/Footer';
import { getCollection, getEntry } from 'astro:content';

const headerEntry = await getEntry('header', 'header');
const heroEntry = await getEntry('hero', 'hero');
const aboutEntry = await getEntry('about', 'about');
const consultoriaEntry = await getEntry('consultoria', 'emilio-matiauda');
const logisticaEntry = await getEntry('logistica', 'logistica');
const footerEntry = await getEntry('footer', 'footer');

const rawProducts = await getCollection('products');
const allBrands = await getCollection('brands');
const allCategoriesEntries = await getCollection('categories');

const dynamicCategories = [
  { id: 'todos', name: 'TODOS' },
  ...allCategoriesEntries.map(cat => ({
    id: cat.id,
    name: cat.data.name.toUpperCase()
  }))
];

const productsWithBrandData = rawProducts.map(product => {
  const brandInfo = allBrands.find(b => b.id === product.data.brand);
  
  return {
    ...product,
    data: {
      ...product.data,
      brand: brandInfo?.data.name || product.data.brand, 
      isOfficial: brandInfo?.data.isOfficial || false
    }
  };
});
---

<Layout title="NutreFitLife Group">
  {headerEntry && <Header client:load data={headerEntry.data} />}
  <main>
    {heroEntry && <Hero client:load data={heroEntry.data} />}
    {aboutEntry && <About client:visible data={aboutEntry.data} />}
    
    <Products 
      client:visible 
      initialProducts={productsWithBrandData} 
      categories={dynamicCategories} 
    />
    
    {consultoriaEntry && <Consultoria client:visible data={consultoriaEntry.data} />}
    {logisticaEntry && <DeliveryInfo client:visible data={logisticaEntry.data} />}
    {footerEntry && <Footer client:visible data={footerEntry.data} />}
  </main>
</Layout>
