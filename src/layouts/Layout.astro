---
// Importa el archivo CSS principal aquí
import '../styles/index.css'; 

interface Props {
    title: string;
}
const { title } = Astro.props;
---

<!doctype html>
<html lang="es">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <title>{title}</title>
    </head>
    <body class="min-h-screen bg-white text-foreground"> <slot />
    </body>
</html>

<style is:global>
    html {
        scroll-behavior: smooth;
    }
</style>
